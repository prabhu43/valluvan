# --- LLM ---
# Provider: groq (default) | openai | ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
# Retrieval mode (eval winner): rerank | dense | sparse | hybrid
#   rerank = dense recall + cross-encoder re-rank (best hit-rate/MRR)
RETRIEVAL_MODE=rerank
# Prompt variant (eval winner): concise | structured
PROMPT_VARIANT=concise
# Query rewriting: rewrite messy user input to a theme query before retrieval.
# Eval showed it HURTS on specific questions, so keep false unless input is vague.
REWRITE_QUERY=false

# Groq (default provider) - get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk-your-key-here
# OpenAI (set LLM_PROVIDER=openai, LLM_MODEL=gpt-4o-mini)
OPENAI_API_KEY=sk-your-key-here
# Ollama (set LLM_PROVIDER=ollama, LLM_MODEL=llama3.1)
OLLAMA_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SPARSE_MODEL=Qdrant/bm25
# Cross-encoder used by rag/rerank.py (English; queries+translations are English)
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# First-stage candidates fed to the reranker, and which retriever produces them
RERANK_CANDIDATES=20
RERANK_BASE_MODE=dense
# Small/fast model used only for query rewriting (rag/query_rewrite.py)
REWRITE_MODEL=llama-3.1-8b-instant

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=thirukkural

# --- Postgres (monitoring) ---
# Backend selector: auto | postgres | jsonl
#   auto     = use Postgres if POSTGRES_HOST is set & reachable, else JSONL file
#   postgres = force Postgres (error if down);  jsonl = force local file
MONITORING_DB=auto
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=valluvan
POSTGRES_USER=valluvan
POSTGRES_PASSWORD=valluvan
# SSL mode: "prefer"/"disable" locally; set "require" for managed cloud DBs.
POSTGRES_SSLMODE=prefer
# --- Cloud Postgres (e.g. Supabase / Neon) ---
# To use Supabase instead of local docker Postgres, set:
#   POSTGRES_HOST=db.<project-ref>.supabase.co
#   POSTGRES_PORT=5432
#   POSTGRES_DB=postgres
#   POSTGRES_USER=postgres
#   POSTGRES_PASSWORD=<your-supabase-db-password>
#   POSTGRES_SSLMODE=require
# Tables are auto-created on first write; no manual migration needed.

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000

# --- App (Streamlit UI) ---
# Host port the containerized Streamlit app is published on (see `make up`).
APP_PORT=8501
